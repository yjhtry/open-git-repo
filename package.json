{
  "publisher": "yjhtry",
  "name": "open-git-repo",
  "displayName": "open-git-repo",
  "version": "0.0.16",
  "packageManager": "pnpm@10.22.0",
  "description": "open github or gitlab repo in browser",
  "author": "yjhtry <860622588@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/yjhtry/open-git-repo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yjhtry/open-git-repo"
  },
  "bugs": {
    "url": "https://github.com/yjhtry/open-git-repo/issues"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.js",
  "icon": "res/icon.png",
  "files": [
    "dist"
  ],
  "engines": {
    "vscode": "^1.106.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsup src/index.ts --external vscode",
    "dev": "nr build --watch",
    "lint": "eslint .",
    "vscode:prepublish": "nr build",
    "publish": "vsce publish --no-dependencies",
    "pack": "vsce package --no-dependencies",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && nr publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@antfu/ni": "^27.0.1",
    "@types/node": "^20.19.25",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.7.0",
    "bumpp": "^10.3.1",
    "eslint": "^9.39.1",
    "esno": "^4.8.0",
    "pnpm": "^10.22.0",
    "rimraf": "^6.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  },
  "commands": [
    {
      "command": "open-git-repo.open"
    }
  ]
}
